{
  "name": "@sagemoyi/openclaw-sub2api-provider",
  "version": "0.1.5",
  "description": "sub2api discovery and capability-aware provider for OpenClaw",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.js",
    "src",
    "data",
    "openclaw.plugin.json",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scripts"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check src/auth.js && node --check src/catalog.js && node --check src/provider.js && node --check src/sync.js && node --check src/lifecycle.js && node --check src/command.js",
    "test:host": "node --test test/host.integration.js",
    "test:gateway": "node --test test/gateway.integration.js",
    "test:live": "node test/live.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "providers": [
      "sub2api-provider"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagemoyi/openclaw-sub2api-provider.git"
  },
  "homepage": "https://github.com/sagemoyi/openclaw-sub2api-provider#readme",
  "bugs": {
    "url": "https://github.com/sagemoyi/openclaw-sub2api-provider/issues"
  }
}
