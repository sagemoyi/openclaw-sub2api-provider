{
  "id": "sub2api-provider",
  "name": "OpenClaw sub2api Provider",
  "description": "Discover sub2api models and capabilities using the standard provider runtime",
  "providers": [
    "sub2api-provider"
  ],
  "setup": {
    "providers": [
      {
        "id": "sub2api-provider",
        "envVars": [
          "SUB2API_API_KEY"
        ]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "refreshSeconds": {
        "type": "integer",
        "minimum": 10,
        "maximum": 86400,
        "default": 86400
      },
      "staleSeconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 86400,
        "default": 300
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 100,
        "maximum": 60000,
        "default": 10000
      },
      "useBundledMetadata": {
        "type": "boolean",
        "default": false
      }
    }
  }
}
